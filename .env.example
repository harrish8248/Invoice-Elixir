# Invoice OCR System Environment Configuration

# Server Settings
PORT=8000
HOST=127.0.0.1
DEBUG=True

# File Intake Security Settings
MAX_FILE_SIZE_MB=15.0
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg

# OCR Settings
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_ACCEPT_THRESHOLD=75.0
MAX_OCR_RETRIES=3

# Processing Directories
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
